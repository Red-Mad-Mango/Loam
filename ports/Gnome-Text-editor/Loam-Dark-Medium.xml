<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="loam-dark-Medium" name="Loam Dark Medium" version="1.0">
  <author>Loam</author>
  <description>Earthy brown dark scheme with low blue light, default contrast.</description>

  <color name="bg0" value="#1e1812"/>
  <color name="bg1" value="#2a2119"/>
  <color name="bg2" value="#3b2f24"/>
  <color name="bg3" value="#4d3e2f"/>
  <color name="bg4" value="#66523d"/>
  <color name="fg0" value="#f3e6cc"/>
  <color name="fg1" value="#e6d3b0"/>
  <color name="fg2" value="#c9b48f"/>
  <color name="gray" value="#8a7658"/>
  <color name="red" value="#c1624a"/>
  <color name="green" value="#8f9a4a"/>
  <color name="yellow" value="#d9a441"/>
  <color name="blue" value="#6f8a8c"/>
  <color name="purple" value="#9c7a8a"/>
  <color name="aqua" value="#7fa08a"/>
  <color name="orange" value="#d9803f"/>
  <color name="bright-orange" value="#e8a06a"/>

  <style name="text" foreground="fg1" background="bg0"/>
  <style name="cursor" foreground="orange"/>
  <style name="selection" background="bg2"/>
  <style name="current-line" background="bg1"/>
  <style name="line-numbers" foreground="gray" background="bg0"/>
  <style name="current-line-number" foreground="fg0" background="bg1"/>
  <style name="bracket-match" foreground="bright-orange" bold="true" background="bg3"/>
  <style name="bracket-mismatch" foreground="red" underline="true" background="bg3"/>
  <style name="search-match" foreground="bg0" background="yellow"/>
  <style name="right-margin" foreground="bg3" background="bg1"/>
  <style name="draw-spaces" foreground="bg4"/>

  <style name="def:keyword" foreground="red"/>
  <style name="def:statement" foreground="red"/>
  <style name="def:type" foreground="yellow"/>
  <style name="def:builtin" foreground="blue"/>
  <style name="def:constant" foreground="purple"/>
  <style name="def:boolean" foreground="purple"/>
  <style name="def:special-constant" foreground="purple"/>
  <style name="def:decimal" foreground="purple"/>
  <style name="def:floating-point" foreground="purple"/>
  <style name="def:base-n-integer" foreground="purple"/>
  <style name="def:character" foreground="green"/>
  <style name="def:string" foreground="green"/>
  <style name="def:special-char" foreground="orange"/>
  <style name="def:comment" foreground="gray" italic="true"/>
  <style name="def:doc-comment-element" foreground="gray"/>
  <style name="def:preprocessor" foreground="aqua"/>
  <style name="def:shebang" foreground="aqua"/>
  <style name="def:note" foreground="blue"/>
  <style name="def:warning" foreground="orange"/>
  <style name="def:error" foreground="red" bold="true"/>
  <style name="def:underlined" foreground="blue" underline="true"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  
  <style name="def:heading" foreground="yellow" bold="true"/>
  <style name="def:thematic-break" foreground="gray" bold="true"/>
  <style name="def:inline-code" foreground="green"/>
  <style name="def:preformatted-section" foreground="green"/>
  <style name="def:link-text" foreground="aqua"/>
  <style name="def:link-destination" foreground="blue" underline="single"/>
  <style name="def:list-marker" foreground="orange" bold="true"/>
  <style name="def:deletion" foreground="gray" strikethrough="true"/>
  <style name="def:insertion" foreground="green" underline="single"/>
</style-scheme>

